generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             Int              @id @default(autoincrement())
  name           String
  email          String           @unique
  password       String
  role           UserRole         @default(USER)
  isActive       Boolean          @default(true)
  tokenVersion   Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  education      String?
  location       String?
  bio            String?
  interests      String[]         @default([])
  skills         String[]         @default([])
  progress       Progress[]
  lessonProgress LessonProgress[]
  enrollments    Enrollment[]
  applications   Application[]
}

enum UserRole {
  USER
  ADMIN
}

model Career {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  steps       Step[]
  jobs        Job[]
}

model Step {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  order       Int
  career      Career     @relation(fields: [careerId], references: [id], onDelete: Cascade)
  careerId    Int
  progress    Progress[]
}

model Progress {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  step      Step     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  stepId    Int
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, stepId])
}

model Job {
  id              Int              @id @default(autoincrement())
  title           String
  company         String?
  location        String?
  description     String?
  url             String?
  employmentType  EmploymentType   @default(FULL_TIME)
  experienceLevel ExperienceLevel?
  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String           @default("AZN")
  companyLogoUrl  String?
  career          Career?          @relation(fields: [careerId], references: [id], onDelete: SetNull)
  careerId        Int?
  course          Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseId        Int?
  applications    Application[]

  @@index([employmentType])
  @@index([experienceLevel])
  @@index([courseId])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
}

enum ExperienceLevel {
  ENTRY_LEVEL
  JUNIOR
  MID_LEVEL
  SENIOR
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

model Application {
  id        Int               @id @default(autoincrement())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     Int
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([status])
}

model Course {
  id          Int             @id @default(autoincrement())
  title       String
  description String?
  published   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  modules     CourseModule[]
  enrollments Enrollment[]
  category    CourseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  Int?
  jobs        Job[]

  @@index([categoryId])
}

model CourseCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]
}

model CourseModule {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId Int
  lessons  Lesson[]

  @@unique([courseId, order])
  @@index([courseId])
}

model Lesson {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  order           Int
  published       Boolean  @default(false)
  videoPath       String?  @unique
  videoMimeType   String?
  videoSizeBytes  Int?
  durationSeconds Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  module   CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId Int
  progress LessonProgress[]

  @@unique([moduleId, order])
  @@index([moduleId])
}

model LessonProgress {
  id        Int      @id @default(autoincrement())
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId Int

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId Int

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}
